{
  "name": "gplx-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA ôn thi GPLX từ dữ liệu ứng dụng Android",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "extract": "node --experimental-sqlite scripts/extract-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/check-http.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "engines": { "node": ">=22.13" }
}
